# Copy to .env.local (gitignored) and fill in. Builds are local (eas build --local), so .env.local is bundled
# through .easignore; never commit it.
EXPO_PUBLIC_API_URL=https://api.library.nitroxis.com
EXPO_PUBLIC_COVERS_URL=https://covers.library.nitroxis.com
# Web OAuth client from financy's Google Cloud project (Credential Manager ID tokens are issued for it).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
