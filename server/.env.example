# Copy to .env (gitignored) for `npm run start:dev`. Production values live in Coolify.
DATABASE_URL=postgresql://library:library@localhost:5432/library
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32-xxxxxxxx
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_IDS=web-client-id.apps.googleusercontent.com,android-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=
ADMIN_EMAILS=mrhammadasif@gmail.com
S3_ENDPOINT=https://s3.home.nitroxis.com
S3_BUCKET=library-covers
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
COVERS_PUBLIC_URL=https://covers.library.home.nitroxis.com
# openssl rand -base64 32
AI_KEYS_KEY=
# Google Books (key from the Nitroxis Technologies GCP project). Requests are capped server-wide per Pacific day.
GOOGLE_BOOKS_API_KEY=
GOOGLE_BOOKS_DAILY_LIMIT=900
# SearXNG for web lookups during AI enrichment (the home instance is locked: pass its API key).
SEARXNG_URL=https://searxng.home.nitroxis.com
SEARXNG_API_KEY=
# Free AI tier through OmniRoute (key in .env.secrets as FREE_AI_API_KEY).
FREE_AI_MODEL=hammad/free
FREE_AI_PER_LIBRARY=5
FREE_AI_DAILY_TOTAL=200
